{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JuanenRac/HYDRA-UMC-DEVELOPER-NODE/contracts/ecosystem_ci_full_report.schema.json",
  "title": "EcosystemCiFullReport",
  "description": "The consolidated result of the complete mode of the ecosystem-ci plugin: one entry per command of the approved plan, run one after another.",
  "type": "object",
  "required": ["contract", "plan_digest", "started_at", "finished_at", "aborted", "results", "summary"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "ecosystem-ci-full-report/1" },
    "plan_digest": { "type": "string", "minLength": 64 },
    "started_at": { "type": "number" },
    "finished_at": { "type": "number" },
    "aborted": { "enum": [null, "cancelled", "low_disk", "total_timeout"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "command", "status", "exit_code", "seconds", "tail", "note"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "command": { "type": "string" },
          "status": { "enum": ["pass", "fail", "timeout", "skipped"] },
          "exit_code": { "type": ["integer", "null"] },
          "seconds": { "type": "number", "minimum": 0 },
          "tail": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "timeout", "skipped"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
